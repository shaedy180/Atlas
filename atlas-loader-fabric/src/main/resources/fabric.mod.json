{
  "schemaVersion": 1,
  "id": "atlas",
  "version": "${version}",
  "name": "Atlas",
  "description": "Recipe and item intelligence: recipes, uses, sources, crafting trees, build plans and notes for every item.",
  "authors": [
    "shaedy180"
  ],
  "contact": {
    "homepage": "https://github.com/shaedy180/Atlas",
    "sources": "https://github.com/shaedy180/Atlas",
    "issues": "https://github.com/shaedy180/Atlas/issues",
    "donate": "https://ko-fi.com/shaedy"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/atlas/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.atlasmod.fabric.AtlasFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=25"
  },
  "suggests": {},
  "custom": {
    "atlas": {
      "plugin_entrypoint": "atlas"
    }
  }
}
